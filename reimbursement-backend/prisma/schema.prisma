generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN     // Treasurer
  FACULTY_MENTOR  // Designated Club Faculty Mentor
  DEAN_STUDENTS   // Dean Students (Final Sanctioning Authority)
  ACCOUNTANT      // Central University Finance / Accountant
  ADMINISTRATOR   // General Admin
}

enum UserDesignation {
  CONVENOR
  DEPUTY_CONVENOR
}

enum PayoutRecipientType {
  STUDENT
  VENDOR
  CLUB_ACCOUNT
}

enum PaymentMode {
  BANK_TRANSFER
  UPI
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  QUERY_RAISED
  CANCELLED
}

enum ReimbursementStage {
  FACULTY_MENTOR
  TREASURER
  ACCOUNTANT_REVIEW
  DEAN_STUDENTS
  AWAITING_PAYMENT
  COMPLETED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  QUERY_RAISED
}

enum BufferTxType {
  MONTHLY_REPLENISHMENT
  TOP_UP
  REIMBURSEMENT_PAYOUT
  REVERSAL
}

enum ProjectionStatus {
  SUBMITTED
  REVIEWED
  ACCEPTED
  APPROVED
  REJECTED
  EXHAUSTED
}

/// Who performed the activity — either a User or an Administrator.
enum ActorType {
  USER
  ADMINISTRATOR
}

/// High-level activity categories recorded in the audit log.
enum ActivityAction {
  SUBMITTED
  APPROVED
  REJECTED
  QUERY_RAISED
  CANCELLED
  RESUBMITTED
  PAYMENT_MARKED
  BILL_ATTACHED
  BILL_DETACHED
  REMARK_ADDED
  OTHER
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id               String              @id @default(cuid())

  name             String
  email            String              @unique
  password         String

  designation      UserDesignation?
  clubName         String?

  resetToken       String?
  resetTokenExpiry DateTime?

  reimbursements   Reimbursement[]
  projections      MonthlyProjection[]
  activityLogs     ActivityLog[]

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([clubName])
}

model ClubMentorMapping {
  id              String        @id @default(cuid())

  clubName        String        @unique // e.g. "Music Club", "Chess Club"

  facultyMentorId String
  facultyMentor   Administrator @relation("ClubFacultyMentor", fields: [facultyMentorId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([facultyMentorId])
}

model Position {
  id             String          @id @default(cuid())

  name           String          @unique
  priority       Int

  administrators Administrator[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Administrator {
  id               String                  @id @default(cuid())

  name             String
  email            String                  @unique
  password         String

  role             AdminRole

  resetToken       String?
  resetTokenExpiry DateTime?

  positionId       String?
  position         Position?               @relation(fields: [positionId], references: [id])

  mentoredClubs    ClubMentorMapping[]     @relation("ClubFacultyMentor")
  approvals        ReimbursementApproval[]
  activityLogs     ActivityLog[]

  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model TreasurerBuffer {
  id             String              @id @default(cuid())

  monthlyAdvance Float               @default(50000.0) // Monthly allocation (₹50,000)
  currentBalance Float               @default(50000.0) // Current available balance
  currentMonth   String              // e.g. "2026-09"

  transactions   BufferTransaction[]

  updatedAt      DateTime            @updatedAt
}

model BufferTransaction {
  id              String          @id @default(cuid())

  bufferId        String
  buffer          TreasurerBuffer @relation(fields: [bufferId], references: [id])

  type            BufferTxType
  amount          Float
  balanceAfter    Float

  reimbursementId String?
  notes           String?

  createdAt       DateTime        @default(now())

  @@index([bufferId])
  @@index([reimbursementId])
}

/// Per-club budget allocation set manually by the Treasurer for a given month.
/// When a reimbursement is marked as paid, spentAmount is incremented.
model ClubBudget {
  id              String   @id @default(cuid())

  clubName        String   // e.g. "Music Club", "Chess Club"
  targetMonth     String   // e.g. "2026-09"

  allocatedAmount Float    @default(0) // Budget sanctioned by Treasurer
  spentAmount     Float    @default(0) // Total paid reimbursements from this club

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clubName, targetMonth])
  @@index([clubName])
  @@index([targetMonth])
}

model ProjectionWindow {
  id               String              @id @default(cuid())

  cycleName        String?             // e.g. "Autumn Fest Cycle (45 Days)"
  targetMonth      String              @unique // Unique cycle key or month (e.g. "2026-10" or "CYCLE-45D-OCT26")
  startDate        DateTime?
  endDate          DateTime?
  durationDays     Int?                @default(45)
  deadline         DateTime
  bufferAmount     Float               @default(100000.0) // Advance buffer pool for this cycle
  usedBufferAmount Float               @default(0.0)      // Total amount reserved by auto-approved projections
  instructions     String?
  isActive         Boolean             @default(true)

  projections      MonthlyProjection[]

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model MonthlyProjection {
  id                   String           @id @default(cuid())

  clubName             String           // e.g. "Music Club"
  targetMonth          String           // e.g. "2026-10"
  cycleId              String?
  cycle                ProjectionWindow? @relation(fields: [cycleId], references: [id])
  totalEstimatedAmount Float            @default(0.0)
  spentAmount          Float            @default(0.0) // Claims processed against this projection
  status               ProjectionStatus @default(APPROVED)
  isAutoApproved       Boolean          @default(true)

  submittedById        String
  submittedBy          User             @relation(fields: [submittedById], references: [id])

  items                ProjectionItem[]
  treasurerRemarks     String?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([clubName, targetMonth])
}

model ProjectionItem {
  id             String            @id @default(cuid())

  projectionId   String
  projection     MonthlyProjection @relation(fields: [projectionId], references: [id], onDelete: Cascade)

  eventName      String
  expectedAmount Float
  description    String?
  tentativeDate  DateTime?

  createdAt      DateTime          @default(now())

  @@index([projectionId])
}

model Reimbursement {
  id                  String                  @id @default(cuid())

  committee           String                  // Club / Committee name
  event               String                  // Event name

  amount              Float
  description         String?

  status              ReimbursementStatus     @default(PENDING)

  currentStage        ReimbursementStage      @default(FACULTY_MENTOR)
  currentPriority     Int                     @default(1) // 1: Faculty, 2: Treasurer/Accountant, 3: Dean Students

  // Specific Faculty Mentor assigned
  assignedFacultyId   String?

  // Buffer & Accountant Escalation
  withinBuffer        Boolean                 @default(true)
  routedToAccountant  Boolean                 @default(false)
  accountantReason    String?
  paidFromBuffer      Boolean                 @default(false)

  // Payout Recipient Details (Provided by C/DC; Student or Vendor)
  recipientType       PayoutRecipientType     @default(STUDENT)
  beneficiaryName     String?
  paymentMode         PaymentMode             @default(BANK_TRANSFER)
  bankName            String?
  accountNumber       String?
  ifscCode            String?
  upiId               String?

  // Manual Payment Mark-off Details
  isPaid              Boolean                 @default(false)
  paidAt              DateTime?
  paidByAdminId       String?
  paymentReference    String?                 // Transaction Ref ID / UTR
  paymentProofUrl     String?

  // Accountant Payment Details (Two-step payout for Post-Event / Accountant flow)
  accountantPaid          Boolean                 @default(false)
  accountantPaidAt        DateTime?
  accountantPaidByAdminId String?
  accountantPaymentRef    String?                 // UTR or Bank Reference from Accountant
  accountantProofUrl      String?
  accountantNotes         String?

  // Advance vs Post-Event Type & Digital Signatures
  claimType               String                  @default("ADVANCE") // "ADVANCE" or "POST_EVENT"
  projectionId            String?
  submissionSignatureUrl  String?
  submissionSignatureHash String?
  submissionSignedAt      DateTime?

  userId              String
  user                User                    @relation(fields: [userId], references: [id])

  approvals           ReimbursementApproval[]
  bills               ReimbursementBill[]
  activityLogs        ActivityLog[]

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([committee])
  @@index([currentStage])
}

model Bill {
  id               String              @id @default(cuid())

  vendorName       String?

  invoiceNumber    String?
  transactionId    String?

  billDate         DateTime?
  amount           Float

  receiptUrl       String

  /**
   * Used to prevent duplicate bill creation.
   * Can be generated from:
   * vendor + invoiceNumber + billDate + amount
   * OR transactionId
   */
  uniqueIdentifier String              @unique

  reimbursements   ReimbursementBill[]

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([invoiceNumber])
  @@index([transactionId])
}

model ReimbursementBill {
  id              String        @id @default(cuid())

  reimbursementId String
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id])

  billId          String
  bill            Bill          @relation(fields: [billId], references: [id])

  allocatedAmount Float

  createdAt       DateTime      @default(now())

  @@unique([reimbursementId, billId])
}

model ReimbursementApproval {
  id              String        @id @default(cuid())

  reimbursementId String
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id])

  administratorId String
  administrator   Administrator @relation(fields: [administratorId], references: [id])

  priority        Int

  status          ApprovalStatus @default(PENDING)

  remark          String?

  // Digital Signature Fields
  signatureImageUrl String?
  signatureHash     String?
  signerName        String?
  signerRole        String?
  signerEmail       String?

  actedAt         DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([reimbursementId])
  @@index([administratorId])
}

/// Immutable audit trail for every significant event on a reimbursement.
model ActivityLog {
  id              String         @id @default(cuid())

  reimbursementId String
  reimbursement   Reimbursement  @relation(fields: [reimbursementId], references: [id])

  /// The high-level action that occurred.
  action          ActivityAction

  /// Free-form description / remark text for this activity.
  activity        String?

  // ── Actor ───────────────────────────────────────────────────────────────
  /// Whether the actor is a regular User or an Administrator.
  actorType       ActorType

  /// Populated when actorType = USER.
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])

  /// Populated when actorType = ADMINISTRATOR.
  administratorId String?
  administrator   Administrator? @relation(fields: [administratorId], references: [id])

  actorRole       String

  createdAt       DateTime       @default(now())

  @@index([reimbursementId])
  @@index([userId])
  @@index([administratorId])
}